---
/**
 * A single migrated post at its original path, so /blog/it-career-guide/part-04-x/
 * here matches blog.oriz.in/blog/it-career-guide/part-04-x/ exactly and no inbound
 * link has to be rewritten.
 */
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import { existsSync } from 'node:fs'
import { join } from 'node:path'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft)
  const ids = new Set(posts.map((p) => p.id))

  const paths: any[] = posts.map((post) => ({ params: { slug: post.id }, props: { post } }))

  // 1. The archive links to both /blog/x/ and /blog/x/index/. The /index/ form is
  //    a redirect stub rather than a second copy, so the postbuild checker does
  //    not flag 100+ duplicate titles.
  for (const post of posts) {
    if (!ids.has(`${post.id}/index`)) {
      paths.push({ params: { slug: `${post.id}/index` }, props: { redirect: `/blog/${post.id}/` } })
    }
  }

  // 2. A year of writing left links to parts that were planned and never
  //    written (it-career-guide part-27 onward, etc.). Rather than editing
  //    hundreds of posts, any /blog/... target with no entry and no file gets a
  //    redirect stub: to its series index when that exists, else to /blog/.
  const linked = new Set<string>()
  for (const post of posts) {
    for (const m of (post.body ?? '').matchAll(/\]\(\/blog\/([^)\s#?]+)/g)) linked.add(m[1].replace(/\/$/, ''))
    for (const m of (post.body ?? '').matchAll(/href="\/blog\/([^"#?]+)/g)) linked.add(m[1].replace(/\/$/, ''))
  }
  for (const target of linked) {
    if (ids.has(target) || ids.has(`${target}/index`)) continue
    if (existsSync(join(process.cwd(), 'public/blog', target))) continue
    const series = target.includes('/') ? target.slice(0, target.lastIndexOf('/')) : ''
    const to = series && (ids.has(series) || ids.has(`${series}/index`)) ? `/blog/${series}/` : '/blog/'
    paths.push({ params: { slug: target }, props: { redirect: to } })
  }

  return paths
}

interface Props {
  post?: CollectionEntry<'blog'>
  redirect?: string
}

const { post, redirect } = Astro.props
const rendered = post ? await render(post) : null
const Content = rendered?.Content
const headings = rendered?.headings ?? []
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const title = post?.data.title ?? 'Redirecting'
const description = post?.data.description ?? 'This part has moved.'
---

{redirect ? (
  <BaseLayout title={`Redirecting — ${redirect}`} description="This page has moved." noindex>
    <div class="container post">
      <meta http-equiv="refresh" content={`0;url=${redirect}`} />
      <p class="moved">
        This part has not been written yet or has moved.
        <a href={redirect}>Continue to {redirect}</a>.
      </p>
    </div>
  </BaseLayout>
) : (
<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={post.data.pubDate}
  keywords={post.data.tags}
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: post.data.title }]}
>
  <article class="container post">
    <header class="head">
      <p class="eyebrow">
        <a href="/blog/">Blog</a>
        {post.data.category && <> · {post.data.category}</>}
        {post.data.series && <> · {post.data.series}</>}
      </p>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="lede">{post.data.description}</p>}
      <p class="meta">
        <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
        {' · '}{post.data.author}
        {post.data.tags.length > 0 && <> · {post.data.tags.slice(0, 4).join(', ')}</>}
      </p>
    </header>

    {toc.length > 2 && (
      <nav class="toc" aria-label="On this page">
        <p>On this page</p>
        <ol>
          {toc.map((h) => (
            <li class:list={[{ sub: h.depth === 3 }]}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose">
      <Content />
    </div>

    <footer class="foot">
      <a href="/blog/">← All posts</a>
    </footer>
  </article>
</BaseLayout>
)}

<style>
  .post { max-width: 46rem; }
  .head { margin: 2rem 0 1.5rem; }
  .eyebrow { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-muted, #8b9aa6); margin: 0 0 0.5rem; }
  .head h1 { font-size: clamp(1.6rem, 3.6vw, 2.3rem); line-height: 1.18; margin: 0 0 0.6rem; }
  .lede { margin: 0 0 0.6rem; color: var(--color-text-muted, #8b9aa6); line-height: 1.6; }
  .meta { margin: 0; font-size: 0.78rem; color: var(--color-text-muted, #8b9aa6); }

  .toc { margin: 1.5rem 0 2rem; padding: 0.9rem 1.1rem; border: 1px solid var(--color-border, rgba(255,255,255,0.1)); border-radius: 8px; font-size: 0.84rem; }
  .toc p { margin: 0 0 0.4rem; font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted, #8b9aa6); }
  .toc ol { margin: 0; padding-left: 1.1rem; }
  .toc li { margin: 0.15rem 0; }
  .toc li.sub { margin-left: 0.9rem; opacity: 0.85; }

  .prose :global(img) { max-width: 100%; height: auto; border-radius: 6px; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--color-border, rgba(255,255,255,0.1)); padding: 0.4rem 0.55rem; text-align: left; }
  .prose :global(blockquote) { border-left: 3px solid currentColor; padding-left: 1rem; opacity: 0.9; }

  .moved { margin-top: 3rem; font-size: 0.9rem; }
  .foot { margin: 2.5rem 0 3rem; padding-top: 1rem; border-top: 1px solid var(--color-border, rgba(255,255,255,0.1)); font-size: 0.85rem; }
</style>
